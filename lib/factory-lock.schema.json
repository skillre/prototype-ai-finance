{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prototype-factory.local/schemas/factory-lock.schema.json",
  "title": "Factory Governance Lock",
  "description": "Factory baseline 自己的治理锁：这一棵树现在处于哪个 starter 版本、哪次 commit、由哪一版策略管理、哪些文件是受管面。锁不是「最新状态」，是「升级那一刻的快照」——所以它记的是 SHA 而不是 HEAD。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "starter",
    "policy",
    "managedSurfaces",
    "unresolved",
    "note"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "kind": {
      "enum": ["factory-baseline"],
      "description": "这份锁记录的是 Factory baseline 自己。派生出的产品把这棵树初始化之后，它描述的是那个产品。"
    },
    "starter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageName", "version", "commit", "recordedOn"],
      "description": "被锁定的 baseline 身份。`commit` 是升级开始时基线 HEAD 的 SHA，不是「当前 HEAD」。",
      "properties": {
        "packageName": { "type": "string", "minLength": 1 },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "读自 package.json 的 version（v1.2.0）。"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "升级时基线 HEAD 的 40 位 SHA。HEAD 之后前进是正常的，锁不会因此失效——但必须能说出它是哪一次。"
        },
        "recordedOn": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "记录日期（YYYY-MM-DD）。"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": {
          "const": "1.3.0",
          "description": "与 factory-policy.json 的 policyVersion 必须一致。"
        }
      }
    },
    "managedSurfaces": {
      "type": "array",
      "minItems": 1,
      "description": "受本策略管理的文件（相对仓库根）。校验器要求每一个都真实存在——列一个不存在的路径等于没有管理它。",
      "items": { "type": "string", "minLength": 1 }
    },
    "unresolved": {
      "type": "array",
      "description": "**未知不猜。** 任何不能核实的外部事实都必须落在这里：`value` 只能是 null，`probe` 写清楚怎么核的、什么结果。把猜测写成事实，比留空更危险。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "what", "why", "probe", "checkedOn", "value"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "what": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 },
          "probe": {
            "type": "string",
            "minLength": 1,
            "description": "实际执行的核实动作与它返回的东西。"
          },
          "checkedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "value": {
            "type": "null",
            "description": "恒为 null：无法核实就是无法核实，这里不允许出现猜出来的值。"
          }
        }
      }
    },
    "note": { "type": "string", "minLength": 1 }
  }
}
